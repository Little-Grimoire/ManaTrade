# Banco de dados
# Sem DATABASE_URL o backend usa SQLite no arquivo DB_STORAGE (desenvolvimento, sem instalar nada).
# Em produção, aponte para o PostgreSQL, ex.: postgres://usuario:senha@host:5432/manatrade
DATABASE_URL=
DB_STORAGE=./data/manatrade.sqlite
# true para ver o SQL gerado pelo Sequelize no terminal
DB_LOG=false

# Senha usada pelos usuários de demonstração criados por "npm run db:seed"
SEED_PASSWORD=manatrade123

# Servidor
PORT=3001
# Origens liberadas no CORS, separadas por vírgula (vazio = todas, só para desenvolvimento)
CORS_ORIGIN=

# Autenticação (JWT). Em produção JWT_SECRET é obrigatório: gere um valor longo e aleatório.
JWT_SECRET=
JWT_EXPIRES_IN=7d
