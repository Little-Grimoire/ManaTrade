{
  "expo": {
    "name": "ManaTrade",
    "slug": "manatrade",
    "scheme": "manatrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Escaneie cartas para identificar e anunciar."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "ManaTrade"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O ManaScan usa a câmera para reconhecer suas cartas."
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1923"
        }
      ]
    ]
  }
}
